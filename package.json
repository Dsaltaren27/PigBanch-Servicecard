{
  "name": "pigbanch-servicecard",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "bundle:create-request-card": "esbuild src/lambdas/create-request-card/handler.ts   --bundle --platform=node --target=node20 --outfile=dist/create-request-card/index.js",
    "bundle:card-activate": "esbuild src/lambdas/card-activate/handler.ts          --bundle --platform=node --target=node20 --outfile=dist/card-activate/index.js",
    "bundle:card-purchase": "esbuild src/lambdas/card-purchase/handler.ts          --bundle --platform=node --target=node20 --outfile=dist/card-purchase/index.js",
    "bundle:card-transaction-save": "esbuild src/lambdas/card-transaction-save/handler.ts  --bundle --platform=node --target=node20 --outfile=dist/card-transaction-save/index.js",
    "bundle:card-paid-credit-card": "esbuild src/lambdas/card-paid-credit-card/handler.ts  --bundle --platform=node --target=node20 --outfile=dist/card-paid-credit-card/index.js",
    "bundle:card-get-report": "esbuild src/lambdas/card-get-report/handler.ts        --bundle --platform=node --target=node20 --outfile=dist/card-get-report/index.js",
    "bundle:card-request-failed": "esbuild src/lambdas/card-request-failed/handler.ts    --bundle --platform=node --target=node20 --outfile=dist/card-request-failed/index.js",
    "bundle:all": "npm run bundle:create-request-card && npm run bundle:card-activate && npm run bundle:card-purchase && npm run bundle:card-transaction-save && npm run bundle:card-paid-credit-card && npm run bundle:card-get-report && npm run bundle:card-request-failed",
    "cdk:synth": "cdk synth  -c stage=dev",
    "cdk:diff": "cdk diff   -c stage=dev",
    "cdk:deploy": "cdk deploy -c stage=dev",
    "cdk:destroy": "cdk destroy -c stage=dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dsaltaren27/PigBanch-Servicecard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Dsaltaren27/PigBanch-Servicecard/issues"
  },
  "homepage": "https://github.com/Dsaltaren27/PigBanch-Servicecard#readme",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1004.0",
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/client-secrets-manager": "^3.1004.0",
    "@aws-sdk/client-sqs": "^3.1004.0",
    "@aws-sdk/lib-dynamodb": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.5.0",
    "esbuild": "^0.27.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts"
    ]
  }
}
